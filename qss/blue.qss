/*QPushButton*/
QPushButton {
	background-color: #473C8B; /*背景色*/
	border-style: outset;
	border-width: 2px;
	border-radius:5px; /*边界圆滑*/
	border-color: #8B7355;
        font: bold 22px;
	color:white; /*字体颜色*/
	font-family:微软雅黑;
	padding: 4px;
	min-width:3em;
}
QPushButton:hover
{
	background-color: rgb(0, 150, 0);
}
QPushButton:pressed
{
	background-color: #1E90FF; /*伪状态经过时背景色*/ 
	border-style: inset;
}
QPushButton:!enabled{
	background-color: rgb(100, 100, 100);
	border-style: inset;
}


/*QLineEdit*/
QLineEdit{
    font-size:18px;
    background:transparent;
    border:none;
    border-bottom:1px solid rgb(229, 229, 229);
}
QLineEdit:hover{
    border-bottom:1px solid rgb(193,193, 193);
}
QLineEdit:focus{
    border-bottom:1px solid rgb(18, 183, 245);
}

/*QGroupBox*/
QGroupBox{
	background:rgb(234, 247, 255);
	border:1px solid black;
	border-radius:10px;
        margin-top:24px;
	font-family:微软雅黑;
        font-size:25px;
}
QGroupBox::title {
      subcontrol-origin: margin;
      subcontrol-position: top left;
      padding-top: 2;
      padding-left: 2;
	  color:blue;
}

/*QLabel*/
QLabel
{ 
	font-family:幼圆;
        font-size:22px;
	color:#000000;
	background-color:transparent;
}


/*QTextBrowser*/
QTextBrowser{
font-family:微软雅黑;
font-size:24px;
}

/*QCheckBox*/
QCheckBox{
    spacing: 5px;  /*勾选框与文字描述间的距离*/
	font-family:幼圆;
        font-size:24px;
	border-radius:2px;
}
QCheckBox:enabled:hover{
    color: rgb(126, 126, 126);
}
QCheckBox:!enabled{
    color: rgb(155, 155, 155);
}
QCheckBox::indicator {  /*修改勾选框的宽度和高度*/
    width: 15px; 
    height: 15px;
}
QCheckBox::indicator:unchecked {  /*修改勾选框的宽度和高度*/
    width: 15px; 
    height: 15px;
}

/*QLCDNumber*/
QLCDNumber{
    font-family:幼圆;
    font-size:30px;
    color:red;
    background-color:transparent;
}










